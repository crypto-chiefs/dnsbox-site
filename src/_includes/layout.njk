<!DOCTYPE html>
<html lang="{{ lang }}" dir="ltr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ translations.layout.page_title | escape }}</title>
  <meta name="description" content="{{ translations.layout.meta_description | escape }}">
  <meta name="author" content="DNSBox Team">
  <meta name="language" content="{{ translations.layout.meta_language | escape }}">
  <link rel="canonical" href="{{ pageUrl }}">
  {% for language in langs %}
  <link rel="alternate" hreflang="{{ language }}" href="https://dnsbox.io/{% if language != 'en' %}{{ language }}.html{% endif %}">
  {% endfor %}
  <link rel="alternate" hreflang="x-default" href="https://dnsbox.io/">
  <meta property="og:title" content="{{ translations.layout.og_title | escape }}">
  <meta property="og:description" content="{{ translations.layout.og_description | escape }}">
  <meta property="og:type" content="website">
  <meta property="og:url" content="{{ pageUrl }}">
  <meta property="og:locale" content="{{ translations.layout.og_locale | escape }}">
  <meta property="og:site_name" content="DNSBox">
  <meta property="og:image" content="https://dnsbox.io/assets/android-chrome-512x512.png">
  <meta property="og:image:width" content="512">
  <meta property="og:image:height" content="512">
  <meta property="og:image:alt" content="{{ translations.layout.og_image_alt | escape }}">
  <meta name="twitter:card" content="summary">
  <meta name="twitter:title" content="{{ translations.layout.og_title | escape }}">
  <meta name="twitter:description" content="{{ translations.layout.og_description | escape }}">
  <meta name="twitter:image" content="https://dnsbox.io/assets/android-chrome-512x512.png">
  <meta name="twitter:image:alt" content="{{ translations.layout.og_image_alt | escape }}">
  <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1">
  <meta name="theme-color" content="#2563eb">
  <meta name="format-detection" content="telephone=no">
  <meta name="yandex-verification" content="6eada1ab9a7faf76">
  <meta name="naver-site-verification" content="989ca8b52f61c9d231965b59074cc4695c8cc28a">
  <link rel="icon" type="image/png" sizes="32x32" href="/assets/favicon-32x32.png">
  <link rel="icon" type="image/png" sizes="16x16" href="/assets/favicon-16x16.png">
  <link rel="apple-touch-icon" sizes="180x180" href="/assets/apple-touch-icon.png">
  <link rel="manifest" href="/assets/site.webmanifest">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap" rel="stylesheet">
  <script type="application/ld+json">{{ softwareSchema | jsonLd | safe }}</script>
  <link href="/assets/styles.css" rel="stylesheet">
</head>
<body>
{% include "sections/language.njk" %}
{% include "sections/header.njk" %}
<main>
{% include "sections/content.njk" %}
</main>
{% include "sections/footer.njk" %}
<a href="https://github.com/crypto-chiefs/dnsbox" target="_blank" rel="noopener noreferrer"
   class="github-button" aria-label="{{ translations.layout.github_button_aria | escape }}">
  <span class="github-tooltip">{{ translations.layout.github_button_label | escape }}</span>
  <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38v-1.49c-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82A7.65 7.65 0 0 1 8 3.13c.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48v2.2c0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8Z"/></svg>
</a>
<script src="/assets/lang-switcher.js" defer></script>
</body>
</html>
